---
layout: empty
lang: tamil
type: blog
permalink: /tamil/blog/feed.xml

date: 2025-06-01
title: RSS Feed
---

<rss xmlns:atom="http://www.w3.org/2005/Atom" xmlns:webfeeds="http://webfeeds.org/rss/1.0" version="2.0">
	<channel>
		<title><![CDATA[{{ site[page.lang][page.type].title }}]]></title>
		<link><![CDATA[{{ site[page.lang][page.type].url }}]]></link>
		<description><![CDATA[{{ site[page.lang][page.type].description }}]]></description>
		<image>
			<url>{{ site.home }}/downloads/assets/icon.png</url>
			<title><![CDATA[{{ site[page.lang][page.type].title }}]]></title>
			<link><![CDATA[{{ site[page.lang][page.type].url }}]]></link>
			<width>144</width>
			<height>144</height>
		</image>
		<atom:icon>{{ site.home }}/downloads/assets/icon.png</atom:icon>
		<atom:logo>{{ site.home }}/downloads/assets/icon.png</atom:logo>
		<webfeeds:icon>{{ site.home }}/downloads/assets/icon.png</webfeeds:icon>
		<webfeeds:logo>{{ site.home }}/downloads/assets/icon.png</webfeeds:logo>
		<webfeeds:accentColor>#3b2219</webfeeds:accentColor>
		<copyright><![CDATA[{{ site.copyright }}]]></copyright>
		<category>Blogs</category>
		<language>ta</language>
		<pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
		<lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
		<atom:link href="{{ site[page.lang][page.type].url }}/feed.xml" rel="self" type="application/rss+xml" />
		<docs>https://www.rssboard.org/rss-specification</docs>
		<generator>Jekyll Liquid Template in Github</generator>
		<managingEditor><![CDATA[{{ site[page.lang].email }} ({{ site[page.lang][page.type].author }})]]></managingEditor>
		<webMaster><![CDATA[{{ site[page.lang].email }} ({{ site[page.lang][page.type].author }})]]></webMaster>

		{% assign filtered_posts = site.posts | where: "lang", page.lang | where: "type", page.type %}
		{% assign sorted_posts = filtered_posts | sort: "date" | reverse %}

		{% for post in sorted_posts %}
			<item>
				<title><![CDATA[{{ post.title }}]]></title>
				<link><![CDATA[{{ site.home }}{{ post.url }}]]></link>
				<description><![CDATA[{{ post.content | markdownify }}<hr/><p>இந்தக் கட்டுரை முதலில் எனது இணையதளத்தில் வெளியிடப்பட்டது: <a href="{{ site.home }}{{ post.url }}">{{ site.home }}{{ post.url }}</a></p>]]></description>
				{% if post.author-name %}
					<author><![CDATA[{{ post.author-email }} ({{ post.author-name }})]]></author>
				{% else %}
					<author><![CDATA[{{ site[page.lang].email }} ({{ site[page.lang][page.type].author }})]]></author>
				{% endif %}
				<category><![CDATA[{{ post.category }}]]></category>
				<pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
				<guid isPermaLink="true">{{ site.home }}{{ post.url }}</guid>
			</item>
		{% endfor %}
	</channel>
</rss>
