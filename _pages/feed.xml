---
layout: empty
permalink: /feed.xml
title: RSS Feed
---

<rss xmlns:atom="http://www.w3.org/2005/Atom" xmlns:webfeeds="http://webfeeds.org/rss/1.0" version="2.0">
	<channel>
		<title><![CDATA[Premkumar Masilamani]]></title>
		<link><![CDATA[{{ site.home }}]]></link>
		<description><![CDATA[Software Craftsman | Life Coach | Writer]]></description>
		<copyright><![CDATA[{{ site.copyright }}]]></copyright>
		<category>Blogs</category>
		<language>en</language>
		<pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
		<lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
		<atom:link href="{{ site.home }}/feed.xml" rel="self" type="application/rss+xml" />
		<docs>https://www.rssboard.org/rss-specification</docs>
		<generator>Jekyll Liquid Template in Github</generator>
		<managingEditor><![CDATA[{{ site.english.blog.email }} ({{ site.english.blog.author }})]]></managingEditor>
		<webMaster><![CDATA[{{ site.english.blog.email }} ({{ site.english.blog.author }})]]></webMaster>
		<image>
			<url>{{ site.home }}/downloads/assets/icon.png</url>
			<title><![CDATA[Premkumar Masilamani]]></title>
			<link><![CDATA[{{ site.home }}]]></link>
			<width>144</width>
			<height>144</height>
		</image>
		<atom:icon>{{ site.home }}/downloads/assets/icon.png</atom:icon>
		<atom:logo>{{ site.home }}/downloads/assets/icon.png</atom:logo>
		<webfeeds:icon>{{ site.home }}/downloads/assets/icon.png</webfeeds:icon>
		<webfeeds:logo>{{ site.home }}/downloads/assets/icon.png</webfeeds:logo>
		<webfeeds:accentColor>#3b2219</webfeeds:accentColor>

		{% assign sorted_posts = site.posts | sort: "date" | reverse %}

		{% for post in sorted_posts limit:20 %}
			<item>
				<title><![CDATA[{{ post.title }}]]></title>
				<link><![CDATA[{{ site.home }}{{ post.url }}]]></link>
				<description><![CDATA[{{ post.content | markdownify }}<hr/><p>Originally published at: <a href="{{ site.home }}{{ post.url }}">{{ site.home }}{{ post.url }}</a></p>]]></description>
				{% if post.author-name %}
					<author><![CDATA[{{ post.author-email }} ({{ post.author-name }})]]></author>
				{% else %}
					<author><![CDATA[{{ site.english.blog.email }} ({{ site.english.blog.author }})]]></author>
				{% endif %}
				<category><![CDATA[{{ post.category }}]]></category>
				<pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
				<guid isPermaLink="true">{{ site.home }}{{ post.url }}</guid>
			</item>
		{% endfor %}
	</channel>
</rss>
